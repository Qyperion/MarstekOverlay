{
  "LogConfiguration": {
    "IsEnabledFileLog": true,
    "FileLogMinimumLevel": "Information",
    "LogFilePath": "diagnostics.log"
  },
  "MarstekApi": {
    "RequestTimeoutMs": 3000,
    "RetryCount": 1,
    "MinDelayBetweenRequestsMs": 1000,
    "DiscoveryDurationMs": 3000
  },
  "Polling": {
    "IntervalSeconds": 30,
    "SlowIntervalSeconds": 300,
    "DisabledMethods": []
  },
  "History": {
    "RetentionDays": 7
  },
  "Storage": {
    "RootDirectory": "",
    "UserSettingsFileName": "settings.json",
    "DatabaseFileName": "history.db"
  }
}
