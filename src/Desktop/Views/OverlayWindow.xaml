<Window x:Class="MarstekOverlay.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MarstekOverlay.Desktop.Controls"
        xmlns:loc="clr-namespace:MarstekOverlay.Desktop.Localization"
        xmlns:monitoring="clr-namespace:MarstekOverlay.Monitoring;assembly=MarstekOverlay.Monitoring"
        Title="{loc:Text Common_ProductName}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Topmost="{Binding IsTopmost}">
    <Border BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1"
            ToolTip="{Binding State.ErrorHint}" MouseLeftButtonDown="Card_MouseLeftButtonDown"
            ContextMenuOpening="Card_ContextMenuOpening">
        <!-- The window takes the size of the card, so scaling the card is all the panel scale comes to. -->
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
        </Border.LayoutTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="252"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Background>
            <SolidColorBrush Color="{StaticResource Color.Card}" Opacity="{Binding CardOpacity}"/>
        </Border.Background>
        <Border.Resources>
            <!-- The buttons of the heading. Their captions are glyphs of the icon font of Windows: Segoe Fluent Icons
                 on Windows 11, Segoe MDL2 Assets, which has the same glyphs at the same codes, on Windows 10.
                 At this width four of them still leave one line for the longest heading on mains, "On mains · charging"
                 in Ukrainian. -->
            <Style TargetType="Button">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Secondary}"/>
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.Track}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Row" TargetType="controls:ReadingRowPanel">
                <Setter Property="Gap" Value="10"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <!-- Painted, if with nothing, so that the hint opens over the gap between the name and the value. -->
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextElement.FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProminent}" Value="True">
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="TextElement.FontSize" Value="13"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Row.Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.Secondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsProminent}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Row.Value" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Marks of the power source for the compact panel, which has no room for the words of the heading. -->
            <Geometry x:Key="Mark.OnMains">M4,1 H6 V5 H4 Z M10,1 H12 V5 H10 Z M2,5 H14 V8 A6,5 0 0 1 2,8 Z M7,12 H9 V16 H7 Z</Geometry>
            <Geometry x:Key="Mark.OnBattery">F0 M1,4 H13 V12 H1 Z M2.5,5.5 V10.5 H11.5 V5.5 Z M13,6.5 H15 V9.5 H13 Z M3.5,6.5 H8 V9.5 H3.5 Z</Geometry>
            <Geometry x:Key="Mark.NoConnection">F0 M8,1 L15.5,14.5 H0.5 Z M7.2,6 H8.8 V10.5 H7.2 Z M7.2,11.5 H8.8 V13 H7.2 Z</Geometry>
        </Border.Resources>
        <Border.ContextMenu>
            <ContextMenu/>
        </Border.ContextMenu>
        <Grid>
            <Grid Margin="14,10,14,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding State.StateText}" ToolTip="{Binding State.StateHint}"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{Binding State.StateTone, Converter={StaticResource ToneToBrush}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,-3,-4,0">
                        <Button Content="&#xE72C;" ToolTip="{loc:Text Overlay_Refresh}"
                                AutomationProperties.Name="{loc:Text Overlay_Refresh}" Command="{Binding RefreshCommand}"/>
                        <Button Content="&#xE9D2;" ToolTip="{loc:Text Overlay_DetailsTooltip}"
                                AutomationProperties.Name="{loc:Text Overlay_DetailsTooltip}"
                                Command="{Binding OpenDetailsCommand}"/>
                        <Button Content="&#xE713;" ToolTip="{loc:Text Overlay_SettingsTooltip}"
                                AutomationProperties.Name="{loc:Text Overlay_SettingsTooltip}"
                                Command="{Binding OpenSettingsCommand}"/>
                        <Button Content="&#xE921;" ToolTip="{loc:Text Overlay_HideTooltip}"
                                AutomationProperties.Name="{loc:Text Overlay_HideTooltip}" Command="{Binding HideCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding State.SocText}" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Primary}" Margin="0,4,0,4"/>

                <ProgressBar Grid.Row="2" Height="8" Maximum="{x:Static monitoring:Percent.Whole}" BorderThickness="0"
                             Value="{Binding State.SocPercent, Mode=OneWay}"
                             Background="{StaticResource Brush.Track}"
                             Foreground="{Binding State.SocTone, Converter={StaticResource ToneToBrush}}"/>

                <controls:LoadChartView Grid.Row="3" Height="50" Margin="0,6,0,0"
                                        Chart="{Binding State.Chart.Chart}" ToolTip="{Binding State.Chart.Hint}"
                                        PlotColumns="{Binding ChartColumns, Mode=OneWayToSource}"
                                        AutomationProperties.Name="{loc:Text Settings_LoadChart}">
                    <controls:LoadChartView.Style>
                        <Style TargetType="controls:LoadChartView" BasedOn="{StaticResource {x:Type controls:LoadChartView}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.Chart}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:LoadChartView.Style>
                </controls:LoadChartView>

                <ItemsControl Grid.Row="4" Margin="0,4,0,0" Focusable="False" ItemsSource="{Binding State.Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text, StringFormat=⚠ {0}}" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="5" Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding State.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ReadingRowPanel ToolTip="{Binding Hint}" Style="{StaticResource Row}">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Row.Label}"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Row.Value}"/>
                            </controls:ReadingRowPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="6" Text="{Binding State.StaleText}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource Brush.Warning}" Style="{StaticResource HiddenWhileEmpty}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="10,5,12,6" ToolTip="{Binding State.CompactHint}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                      Fill="{Binding State.StateTone, Converter={StaticResource ToneToBrush}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.Supply}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.Supply}" Value="OnMains">
                                    <Setter Property="Data" Value="{StaticResource Mark.OnMains}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.Supply}" Value="OnBattery">
                                    <Setter Property="Data" Value="{StaticResource Mark.OnBattery}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.Supply}" Value="NoConnection">
                                    <Setter Property="Data" Value="{StaticResource Mark.NoConnection}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <TextBlock Text="{Binding State.SocText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{Binding State.SocTone, Converter={StaticResource ToneToBrush}}"/>

                <TextBlock Text="{Binding State.CompactText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{Binding State.CompactTone, Converter={StaticResource ToneToBrush}}"/>

                <TextBlock Text="⚠" ToolTip="{Binding State.CompactAlert.Text}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{Binding State.CompactAlert.Tone, Converter={StaticResource ToneToBrush}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.CompactAlert}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
